# Formulae and casks that ./bootstrap installs and upgrades with `brew bundle` on macOS.
# Homebrew's Brewfile format: https://docs.brew.sh/Brew-Bundle-and-Brewfile
# Not listed: what macOS already has (less, zsh, zip, unzip, sqlite3, tar, diff, lsof, curl, ssh),
# strace (Linux-only), fontconfig (install looks in ~/Library/Fonts) and python (uv provides it).

# dalftui requirements
brew "git"                  # bootstrap's git pull; newer than the Command Line Tools' git
brew "tmux"                 # requires 3.2+
brew "oh-my-posh"           # the prompt
brew "uv"                   # runs bootstrap, install, bin/reload and the tmux keys (Apple's python3 is 3.9)

# The owner's personal tools
brew "mise"
brew "lsd"
brew "bat"
brew "ripgrep"
brew "fzf"
brew "jq"
brew "yq"                   # mikefarah/yq
brew "btop"
brew "wget"
brew "gh"
brew "htop"
brew "midnight-commander"   # command: mc
brew "sevenzip"             # command: 7zz
brew "nano"                 # macOS's nano is pico
brew "socat"
brew "libfido2"             # fido2-token and the other FIDO2 tools
brew "dvc"
brew "awscli"
brew "rclone"

# Desktop
cask "visual-studio-code"   # VS Code updates itself; links the code command
cask "font-hack-nerd-font"  # the prompt font, in ~/Library/Fonts
