#!/usr/bin/env python3
"""Install the packages and tools in packages/fedora.txt, debian.txt, windows.txt or Brewfile, update this checkout, then run ./install or install.cmd."""
import argparse
import os
import shutil
import sys

sys.dont_write_bytecode = True
if sys.version_info < (3, 11):  # The bootstrap module needs Python 3.11 to import.
    if sys.platform == 'darwin' and shutil.which('uv'):  # macOS's python3 is 3.9; uv runs a newer one.
        os.execvp('uv', ['uv', 'run', '--no-project', '--python', '>=3.11', '--script', os.path.abspath(__file__),
                         *sys.argv[1:]])
    raise SystemExit('Bootstrap failed: Python 3.11 or newer is required'
                     + (' (macOS: brew install uv, then rerun).' if sys.platform == 'darwin' else '.'))
if os.name == 'nt':
    from dalftui.windows.bootstrap import bootstrap
else:
    from dalftui.linux.bootstrap import bootstrap


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='Show what would change without changing anything')
    parser.add_argument('--server', action='store_true',
                        help='Skip the [desktop] packages and the VS Code and DVC repositories, and pass --server to ./install')
    args = parser.parse_args()
    return bootstrap(dry_run=args.dry_run, server=args.server, argv=sys.argv[1:])


if __name__ == '__main__':
    raise SystemExit(main())
