#!/usr/bin/env python3
"""Install or uninstall dalftui configuration links and loaders, then reload running tmux and Alacritty."""
import argparse
import os
import shutil
import sys
import subprocess

sys.dont_write_bytecode = True
if sys.version_info < (3, 11):  # The setup module needs Python 3.11 to import.
    if sys.platform == 'darwin' and shutil.which('uv'):  # macOS's python3 is 3.9; uv runs a newer one.
        os.execvp('uv', ['uv', 'run', '--no-project', '--python', '>=3.11', '--script', os.path.abspath(__file__),
                         *sys.argv[1:]])
    raise SystemExit('Install failed: Python 3.11 or newer is required'
                     + (' (macOS: brew install uv, then rerun).' if sys.platform == 'darwin' else '.'))
from dalftui.linux.setup import dependencies, install, installed_profile, reload_config, uninstall


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='Show changes without writing files')
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--server', dest='profile', action='store_const', const='server',
                      help='Configure tmux for a server without requiring Alacritty or an SSH picker')
    mode.add_argument('--desktop', dest='profile', action='store_const', const='desktop',
                      help='Configure Alacritty and tmux (the default for a new Linux installation)')
    mode.add_argument('--macos', dest='profile', action='store_const', const='macos',
                      help='Configure tmux and the zsh prompt on macOS (the default for a new Mac installation)')
    mode.add_argument('--uninstall', action='store_true',
                      help='Remove the links, loaders and settings that install added')
    parser.add_argument('--socket', metavar='PATH', help='Reload this tmux server socket instead of the default one')
    args = parser.parse_args()
    if args.uninstall:
        try:
            uninstall(dry_run=args.dry_run)
        except (OSError, ValueError) as error:
            print(f'Uninstall failed: {error}', file=sys.stderr)
            return 1
        return 0
    try:
        profile = args.profile or installed_profile()
        dependencies(profile)
        install(dry_run=args.dry_run, profile=profile)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'Install failed: {error}', file=sys.stderr)
        return 1
    if args.dry_run:
        return 0
    try:
        reload_config(socket=args.socket)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'Reload failed: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
