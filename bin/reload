#!/usr/bin/env python3
"""Reload installed Alacritty/tmux settings without ending tmux sessions."""
import argparse
import os
from pathlib import Path
import shutil
import sys
import subprocess

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
if sys.version_info < (3, 11):  # The setup module needs Python 3.11 to import.
    if sys.platform == 'darwin' and shutil.which('uv'):  # macOS's python3 is 3.9; uv runs a newer one.
        os.execvp('uv', ['uv', 'run', '--no-project', '--python', '>=3.11', '--script', os.path.abspath(__file__),
                         *sys.argv[1:]])
    raise SystemExit('Reload failed: Python 3.11 or newer is required'
                     + (' (macOS: brew install uv, then rerun).' if sys.platform == 'darwin' else '.'))
from dalftui.linux.setup import reload_config


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--socket', metavar='PATH', help='Reload a specific tmux server socket')
    args = parser.parse_args()
    try:
        reload_config(socket=args.socket)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'Reload failed: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
